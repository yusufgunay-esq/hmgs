# ==============================================================================
# HMGS GÜVENLİK VE GİT SÜZGEÇ DOSYASI (.gitignore)
# ==============================================================================

# --- 1. GİZLİ KİMLİK BİLGİLERİ (ASLA COMMIT EDİLMEMELİ) ---
HMGS_Takip_App/sync/client_secret.json
HMGS_Takip_App/sync/.tokens.json
HMGS_Takip_App/sync/sync.log
HMGS_Takip_App/sync/.pushed_studio_sessions.json
.env
*.env
*.pem
*.key

# --- 2. KİŞİSEL ÇALIŞMA VERİSİ (Google Drive ile cihazlar arası eşitlenir) ---
HMGS_Takip_App/uploads/
HMGS_Takip_App/ocr_results.json
HMGS_Takip_App/work/ocr_*.txt
HMGS_Takip_App/claude_tasks.json
HMGS_Takip_App/claude_report*.json
HMGS_Takip_App/task_history.json
HMGS_Takip_App/refs/
studio_sessions_export.json
HMGS_Drive_Yedek/

# --- 3. AĞIR TARAMA VE ARŞİV DOSYALARI ---
scans/to_process/
scans/archive/
*.bak*
*.tmp

# --- 4. SİSTEM, PAKET VE ÖNBELLEK DOSYALARI ---
node_modules/
__pycache__/
*.pyc
.venv/
log/
*.log
.DS_Store
Thumbs.db

# --- 5. TELİFLİ SORU BANKALARI VE GİZLİ VERİ KASASI (Google Drive Vault ile eşitlenir) ---
questions.js
topics.js
kitap_envanteri.js
data/
hmgs_vault.json
hmgs_2026_data.json
sync/github_token.txt
HMGS_Takip_App/sync/github_token.txt


HMGS_Android/
scratch/
# ==============================================================================
# --- 6. VARSAYILAN YASAK (DEFAULT-DENY): SIFIR-VERI KABUGU KORUMASI ---
# ==============================================================================
# NOT: Yukaridaki kara liste tek basina YETMEZ. Bir dosya bir kez "git add" ile
# takibe alinmissa .gitignore onu artik korumaz (takip edilen dosya ignore edilmez).
# Bu yuzden bu bolumde kok dizindeki HER SEY yasaklanir; yalnizca GitHub'a
# yayinlanan arayuz kabugu acikca izinli birakilir. Boylece "git add ."
# calistirilsa dahi soru bankasi, sinav taramasi, kisisel not veya takip verisi
# pakete giremez.
/*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/README.md
!/LICENSE
!/robots.txt
!/index.html
!/portal.html
!/sw.js
!/studio.html
!/studio.webmanifest
!/questions_ai.js
!/apple-touch-icon.png
!/favicon.ico
!/favicon.png
!/icons/
!/js/
!/studio/
!/.githooks/
# Studyo test / fixture dosyalari yayinlanmaz
/studio/test/